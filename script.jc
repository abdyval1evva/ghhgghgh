/* =====================================================
   Управление презентацией: масштаб, переходы, диаграммы
   ===================================================== */
(function () {
  const stage = document.getElementById('stage');
  const slides = Array.from(document.querySelectorAll('.slide'));
  const bar = document.getElementById('bar');
  const cnt = document.getElementById('cnt');
  const ui = document.getElementById('ui');
  const hint = document.getElementById('hint');
  let cur = -1;
  const pad = n => String(n).padStart(2, '0');

  /* ---------- 1. Масштаб сцены 1440×810 под любой экран ---------- */
  function scale() {
    const s = Math.min(innerWidth / 1440, innerHeight / 810);
    stage.style.transform = 'translate(-50%,-50%) scale(' + s + ')';
  }
  addEventListener('resize', scale);
  scale();

  /* ---------- 2. Подгонка крупных заголовков по ширине ---------- */
  function fitAll() {
    document.querySelectorAll('[data-fit]').forEach(el => {
      el.style.fontSize = '';
      const max = parseFloat(el.dataset.fit);
      let fs = parseFloat(getComputedStyle(el).fontSize);
      let guard = 80;
      while (el.offsetWidth > max && fs > 24 && guard--) {
        fs -= 4;
        el.style.fontSize = fs + 'px';
      }
    });
  }

  /* ---------- 3. Диаграммы (столбцы) из данных ---------- */
  function buildBars(id, items, maxH, hotFn) {
    const box = document.getElementById(id);
    if (!box) return;
    const max = Math.max.apply(null, items.map(i => i.v));
    box.innerHTML = items.map((i, k) => {
      const h = Math.round((i.v / max) * maxH);
      return '<div class="b' + (hotFn(i, k) ? ' hot' : '') + '">' +
        '<span class="val" style="--d:' + (1.2 + k * 0.12) + 's">' + i.t + '</span>' +
        '<i style="height:' + h + 'px;--d:' + (1.2 + k * 0.12) + 's"></i>' +
        '<span class="lab">' + i.l + '</span></div>';
    }).join('');
  }
  // Причина 1: потери от схем, начавшихся в соцсетях, млрд $ (FTC)
  buildBars('chartA', [
    { l: '2020', v: 0.261, t: '0,26' }, { l: '2021', v: 0.789, t: '0,79' },
    { l: '2022', v: 1.2, t: '1,2' },    { l: '2023', v: 1.5, t: '1,5' },
    { l: '2024', v: 1.9, t: '1,9' },    { l: '2025', v: 2.1, t: '2,1' }
  ], 270, (i, k) => k === 5);
  // Причина 3: доля обращений через соцсети по возрасту, % (FTC)
  buildBars('chartC', [
    { l: '18–29', v: 40, t: '40' }, { l: '30–39', v: 32, t: '32' },
    { l: '40–49', v: 32, t: '32' }, { l: '50–59', v: 32, t: '32' },
    { l: '60–69', v: 29, t: '29' }, { l: '70–79', v: 23, t: '23' },
    { l: '80+', v: 14, t: '14' }
  ], 270, (i, k) => k === 0 || k === 6);

  /* ---------- 4. Счётчики «от нуля до значения» ---------- */
  function runCounts(slide) {
    slide.querySelectorAll('[data-count]').forEach(el => {
      const to = parseFloat(el.dataset.count);
      const suf = el.dataset.suffix || '';
      const pre = el.dataset.prefix || '';
      const t0 = performance.now() + 900, dur = 1500;
      el.textContent = pre + '0' + suf;
      (function tick(now) {
        const p = Math.min(Math.max((now - t0) / dur, 0), 1);
        const e = 1 - Math.pow(1 - p, 3);
        el.textContent = pre + Math.round(to * e) + suf;
        if (p < 1) requestAnimationFrame(tick);
      })(performance.now());
    });
  }

  /* ---------- 5. Переход между слайдами ---------- */
  function go(i) {
    if (i < 0 || i >= slides.length || i === cur) return;
    const dir = i > cur ? 1 : -1;
    const prev = slides[cur], next = slides[i];
    slides.forEach(s => s.classList.remove('leaving'));
    if (prev) { prev.classList.remove('active'); prev.classList.add('leaving'); }
    next.setAttribute('data-dir', dir);
    // перезапуск анимаций, если слайд показывают повторно
    next.classList.remove('active'); void next.offsetWidth;
    next.classList.add('active');
    cur = i;
    runCounts(next);
    bar.style.width = ((i + 1) / slides.length * 100) + '%';
    cnt.textContent = pad(i + 1) + ' / ' + pad(slides.length);
    history.replaceState(null, '', '#' + (i + 1));
    setTimeout(() => prev && prev.classList.remove('leaving'), 1100);
  }
  const next = () => go(cur + 1), prev = () => go(cur - 1);

  document.getElementById('next').onclick = next;
  document.getElementById('prev').onclick = prev;
  document.getElementById('fs').onclick = () => {
    if (!document.fullscreenElement) document.documentElement.requestFullscreen && document.documentElement.requestFullscreen();
    else document.exitFullscreen();
  };

  addEventListener('keydown', e => {
    if (['ArrowRight', 'ArrowDown', 'PageDown', ' ', 'Enter'].includes(e.key)) { e.preventDefault(); next(); }
    else if (['ArrowLeft', 'ArrowUp', 'PageUp', 'Backspace'].includes(e.key)) { e.preventDefault(); prev(); }
    else if (e.key === 'Home') go(0);
    else if (e.key === 'End') go(slides.length - 1);
    else if (e.key === 'f' || e.key === 'F' || e.key === 'а' || e.key === 'А') document.getElementById('fs').click();
  });

  // клик по сцене (кроме кнопок) и свайп на телефоне
  stage.addEventListener('click', e => {
    const r = stage.getBoundingClientRect();
    (e.clientX - r.left) > r.width * 0.3 ? next() : prev();
  });
  let tx = null;
  addEventListener('touchstart', e => { tx = e.touches[0].clientX; }, { passive: true });
  addEventListener('touchend', e => {
    if (tx === null) return;
    const dx = e.changedTouches[0].clientX - tx;
    if (Math.abs(dx) > 50) dx < 0 ? next() : prev();
    tx = null;
  });
  addEventListener('wheel', (() => {
    let lock = false;
    return e => {
      if (lock || Math.abs(e.deltaY) < 30) return;
      lock = true; e.deltaY > 0 ? next() : prev();
      setTimeout(() => lock = false, 1200);
    };
  })(), { passive: true });

  /* ---------- 6. Параллакс графики за мышью ---------- */
  addEventListener('mousemove', e => {
    const x = (e.clientX / innerWidth - 0.5) * 30;
    const y = (e.clientY / innerHeight - 0.5) * 20;
    stage.style.setProperty('--px', x + 'px');
    stage.style.setProperty('--py', y + 'px');
    ui.classList.remove('hide');
    clearTimeout(window.__hideUi);
    window.__hideUi = setTimeout(() => ui.classList.add('hide'), 2600);
  });

  /* ---------- 7. Старт ---------- */
  function start() {
    fitAll();
    const n = parseInt(location.hash.slice(1), 10);
    go(n >= 1 && n <= slides.length ? n - 1 : 0);
    setTimeout(() => hint.classList.add('gone'), 5000);
    window.__hideUi = setTimeout(() => ui.classList.add('hide'), 4000);
  }
  if (document.fonts && document.fonts.ready) {
    document.fonts.ready.then(start);
    setTimeout(() => { if (cur === -1) start(); }, 2500); // если шрифты не загрузились (нет интернета)
  } else start();
  addEventListener('load', fitAll);
})();
